## Ignore travis config file
^\.travis\.yml$
\.vscode
^\.clangd$
^.*\.Rproj$
^\.Rproj\.user$
^build$
^build\.sh$
^clean\.sh$
^.*\.tar\.gz$
(^|/)\.DS_Store$
^tests$
^Vignettes$
^vignettes$
^tools/(benchmark_lag_gap1|build-cran-source|profile_scp_solver|validate_scp_solver)[.]R$
^tools/benchmarks$
^(?!R/).*[.]R$
