diff --git a/R/Makefile b/R/Makefile
--- a/R/Makefile
+++ b/R/Makefile
@@ -77,10 +77,12 @@ STAGE2_CPPFLAGS += -fwasm-exceptions
 STAGE2_CPPFLAGS += -s SUPPORT_LONGJMP=wasm
 STAGE2_CPPFLAGS += --use-port=zlib
 STAGE2_CPPFLAGS += --use-port=bzip2
+STAGE2_CPPFLAGS += -pthread
 
 STAGE2_CFLAGS := $(STAGE2_CFLAGS)
 STAGE2_CFLAGS += $(WASM_OPT)
 STAGE2_CFLAGS += -fPIC
+STAGE2_CFLAGS += -pthread
 
 STAGE2_LDFLAGS := $(STAGE2_LDFLAGS)
 STAGE2_LDFLAGS += $(WASM_OPT)
@@ -88,6 +90,7 @@ STAGE2_LDFLAGS += -L$(WASM)/lib
 STAGE2_LDFLAGS += -fwasm-exceptions
 STAGE2_LDFLAGS += -s SUPPORT_LONGJMP=wasm
 STAGE2_LDFLAGS += --use-port=freetype # See r-wasm/webr#504, 56069e2
+STAGE2_LDFLAGS += -pthread
 
 STAGE2_FFLAGS := $(STAGE2_FFLAGS)
 STAGE2_FFLAGS += --target=wasm32-unknown-emscripten
@@ -118,6 +121,7 @@ EXPORTED_RUNTIME_METHODS=[$\
 ]
 
 MAIN_LDFLAGS := -s MAIN_MODULE=1
+MAIN_LDFLAGS += -pthread
 MAIN_LDFLAGS += -s ALLOW_MEMORY_GROWTH=1
 MAIN_LDFLAGS += -s STACK_SIZE=1MB
 MAIN_LDFLAGS += -s INITIAL_MEMORY=32MB
@@ -138,7 +142,9 @@ ifdef WEBR_LIB
 MAIN_LDFLAGS_ADD += --preload-file "${WEBR_LIB}@/usr/lib/R/library"
 endif
+MAIN_LDFLAGS_ADD += -s PTHREAD_POOL_SIZE=3
+MAIN_LDFLAGS_ADD += -s PTHREAD_POOL_SIZE_STRICT=2
 
-SHLIB_LDFLAGS := -s SIDE_MODULE=1
+SHLIB_LDFLAGS := -s SIDE_MODULE=1 -pthread
 
 $(BUILD)/state/R-$(R_VERSION)/r-stage2-configured: $(BUILD)/state/R-$(R_VERSION)/r-patched $(FORTRAN_WASM_LIB)
 	@mkdir -p $(R_SOURCE)/build
diff --git a/packages/webr-vars.mk b/packages/webr-vars.mk
--- a/packages/webr-vars.mk
+++ b/packages/webr-vars.mk
@@ -7,7 +7,7 @@ WEBR_HOST_INCLUDES = -I$(R_SOURCE)/build-stage1/include -I$(R_SOURCE)/src/include
 WEBR_LDFLAGS = -L$(WEBR_ROOT)/wasm/lib
 
 EM_CXX_FIXES = -DRCPP_DEMANGLER_ENABLED=0 -D__STRICT_ANSI__
-EM_CFLAGS = $(WEBR_HOST_INCLUDES) $(WASM_OPT) -fvisibility=default
+EM_CFLAGS = $(WEBR_HOST_INCLUDES) $(WASM_OPT) -fvisibility=default -pthread
 
 CXX98 = em++
 CXX11 = em++
@@ -24,7 +24,7 @@ CXX14FLAGS = -std=gnu++14 $(EM_CXX_FIXES) $(EM_CFLAGS)
 CXX17FLAGS = -std=gnu++17 $(EM_CXX_FIXES) $(EM_CFLAGS)
 CXX20FLAGS = -std=gnu++20 $(EM_CXX_FIXES) $(EM_CFLAGS)
-LDFLAGS = -s SIDE_MODULE=1 -s WASM_BIGINT -s ASSERTIONS=1 $(WEBR_LDFLAGS) $(WASM_OPT)
+LDFLAGS = -s SIDE_MODULE=1 -s WASM_BIGINT -s ASSERTIONS=1 $(WEBR_LDFLAGS) $(WASM_OPT) -pthread
 FC = emfc
 FLIBS = $(FORTRAN_WASM_LDADD)
 AR = emar
